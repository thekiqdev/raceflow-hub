    "frontend": [
      { "function": "normalizePersonName", "ux": "onBlur format title case" },
      { "function": "maskPhone + validatePhone", "surfaces": ["AdminManualRunnerCreate", "UserProfileDialog", "OrganizerSettings"] },
      { "function": "maskCep + validateCep", "surfaces": ["AdminManualRunnerCreate address fields"] },
      { "function": "blockDigitsInName", "surfaces": "all name inputs" }
    ]
  },
  "compatibility_constraints": {
    "do_not_revalidate_on_read": [
      "export registrations CSV",
      "rankings display",
      "certificates PDF",
      "check-in lists",
      "Asaas customer data already sent",
      "financial reports",
      "public APIs returning profile as stored"
    ],
    "strategy": "normalize on write (create/update); optional admin bulk cleanup script later; grandfather existing rows"
  },

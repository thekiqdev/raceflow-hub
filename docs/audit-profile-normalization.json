  "normalization_candidates": {
    "backend": [
      { "function": "normalizePersonName", "apply_on": ["register", "updateProfile", "createRunnerByOrganizer", "createManualRunner"] },
      { "function": "normalizeEmail", "apply_on": ["register", "updateProfile", "createRunnerByOrganizer", "createManualRunner", "profilesController"] },
      { "function": "normalizePhoneDigits", "apply_on": ["register", "updateProfile", "createRunnerByOrganizer", "createManualRunner"] },
      { "function": "normalizePostalCode", "apply_on": ["register", "updateProfile"] },
      { "function": "normalizePlaceName", "apply_on": ["city", "neighborhood"] },
      { "function": "validateFullName", "apply_on": "all write paths — min 2 words, no digits" },
      { "function": "validateBirthDateRange", "apply_on": "register, createManualRunner", "range_years": [8, 120] }

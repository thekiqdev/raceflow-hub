  "proposed_architecture": {
    "scenario_A_valid_found": {
      "behavior": "Manter fluxo atual: lookup-cpf → autopreenchimento → proof JWT → register",
      "changes": "Nenhuma obrigatória"
    },
    "scenario_B_valid_not_found": {
      "behavior": "Permitir continuar com preenchimento manual; não bloquear",
      "recommended_changes": [
        "cpfLookupService: retornar code CPF_NOT_IN_REGISTRY (ou similar) distinto de LOCAL_INVALID_FORMAT",
        "lookupCpfController: HTTP 200 com flag manual_entry_allowed + proof alternativo (ex. cpf_manual_v1 assinado só com CPF válido)",
        "useCpfBrasilLookup: tratar NOT_FOUND como sucesso parcial — liberar campos editáveis",
        "authService.register: aceitar proof manual OU proof API; não exigir match nome/nasc da API",
        "UI: mensagem clara 'CPF válido não encontrado na base — preencha seus dados manualmente'"
      ]
    },
    "scenario_C_invalid": {
      "behavior": "Bloquear com mensagem CPF inválido",
      "changes": "Manter isValidCpfDigits/validateCpf em todas as camadas; corrigir GAP em createRunnerByOrganizer"
    }
  },
